# Copy to .env.local for local development (never commit .env.local), and add the same variables in
# Vercel → Project → Settings → Environment Variables. See docs/SUPABASE.md.

# Supabase → Project Settings → API Keys (publishable key) and Data API (project URL).
# Both are public values designed for the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Optional: origin used in links inside auth emails when the request's host isn't recognised.
# Defaults to https://capsera.shop. For local development the request origin (http://localhost:3000) is used.
# NEXT_PUBLIC_SITE_URL=https://capsera.shop

# Never add the secret / service_role key or the database password here or to any NEXT_PUBLIC_ variable.
# This app doesn't need them.
